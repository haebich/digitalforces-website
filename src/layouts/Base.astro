---
import '../styles/global.css';
const { title, description } = Astro.props;
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#07110f" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <script>
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => entry.isIntersecting && entry.target.classList.add('is-visible'));
      }, { threshold: 0.15 });
      document.querySelectorAll('[data-reveal]').forEach((el) => observer.observe(el));

      document.querySelectorAll('[data-service]').forEach((button) => {
        button.addEventListener('click', () => {
          document.querySelectorAll('[data-service]').forEach((item) => item.setAttribute('aria-selected', 'false'));
          button.setAttribute('aria-selected', 'true');
          const target = document.querySelector('[data-service-copy]');
          if (target) target.textContent = button.getAttribute('data-copy') || '';
        });
      });
    </script>
  </body>
</html>
