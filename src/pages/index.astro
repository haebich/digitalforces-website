---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
const services = [
  { name: 'Shopware Engineering', problem: 'Dein Shopware-System ist geschäftskritisch, aber Änderungen, Integrationen oder Betrieb erzeugen unnötige Risiken.', result: 'Eine belastbare technische Grundlage, die sich nachvollziehbar betreiben und weiterentwickeln lässt.', scope: 'Integrationen, Erweiterungen, Performance, Stabilisierung, Betrieb und Weiterentwicklung.', entry: 'Technische Bestandsaufnahme mit priorisierten Handlungsfeldern.' },
  { name: 'E-Commerce Business Consulting', problem: 'Viele Anforderungen konkurrieren miteinander; technische und geschäftliche Prioritäten sind nicht sauber verbunden.', result: 'Ein klares Zielbild und eine belastbare Roadmap für die nächsten Entscheidungen.', scope: 'Ziele, Prozesse, Priorisierung, Lösungsschnitt und Entscheidungsgrundlagen.', entry: 'Fokussierter Workshop zu Ausgangslage, Zielen und Abhängigkeiten.' },
  { name: 'KI-Consulting', problem: 'Es gibt Ideen für KI, aber noch keinen belastbaren Anwendungsfall oder Nachweis, dass Aufwand, Datenlage und Nutzen zusammenpassen.', result: 'Eine fundierte Entscheidung: umsetzen, anders lösen oder bewusst verwerfen.', scope: 'Use-Case-Prüfung, Daten- und Risikobewertung, Prototyping und Umsetzungsplanung.', entry: 'Chancencheck für einen konkreten Prozess oder Anwendungsfall.' },
  { name: 'Individuelle Entwicklung', problem: 'Standardfunktionen und vorhandene Systeme bilden einen wichtigen Geschäftsprozess nicht ausreichend ab.', result: 'Eine passende Erweiterung oder Anwendung mit klaren Schnittstellen und wartbarer Architektur.', scope: 'Individuelle Erweiterungen, Integrationen, interne Werkzeuge und eigenständige Anwendungen.', entry: 'Problem- und Lösungsschnitt vor der ersten Implementierung.' },
];
---
<Base title="DigitalForces – Shopware, Beratung und individuelle Entwicklung" description="DigitalForces entwickelt und verbessert anspruchsvolle Shopware-Systeme – mit technischer Strategie, E-Commerce-Beratung, KI-Consulting und individueller Entwicklung.">
  <div id="top" class="page-shell">
    <Header />
    <main>
      <section class="hero">
        <div class="hero-kicker"><span></span> Shopware Engineering · E-Commerce Consulting</div>
        <h1>Shopware,<br /><em>das belastbar</em><br />funktioniert.</h1>
        <div class="hero-bottom">
          <div><p>Wir entwickeln, stabilisieren und verbessern anspruchsvolle Shopware-Systeme – technisch fundiert und mit Blick auf dein Geschäft.</p><div class="hero-actions"><a class="text-link" href="#contact">Projekt besprechen ↗</a><a class="secondary-link" href="#expertise">Leistungen ansehen ↓</a></div></div>
        </div>
        <div class="orbit orbit-one"></div><div class="orbit orbit-two"></div>
      </section>

      <section class="signal" aria-label="Leistungsversprechen">
        <span>BAUEN</span><i>✦</i><span>BETREIBEN</span><i>✦</i><span>VERBESSERN</span><i>✦</i>
      </section>
      <section class="section problem" data-reveal><div class="section-label">00 / Ausgangslage</div><div><p class="eyebrow">Wenn Wachstum Reibung erzeugt</p><h2>Viele Symptome.<br />Ein <em>System.</em></h2><p class="lead compact">Langsame Releases, manuelle Umwege und instabile Integrationen sind selten Einzelprobleme. Wir betrachten Shop, Prozesse, Daten und Betrieb gemeinsam – damit nicht nur das nächste Ticket verschwindet, sondern die Ursache klar wird.</p><div class="flow"><span>Änderungen werden riskant</span><b>→</b><span>Systeme greifen nicht ineinander</span><b>→</b><span>Kontext bleibt unklar</span><strong>Analyse → Lösungsschnitt → Umsetzung → Weiterentwicklung</strong></div></div></section>

      <section id="expertise" class="section expertise" data-reveal>
        <div class="section-label">01 / Expertise</div>
        <div>
          <p class="eyebrow">Was wir lösen</p>
          <h2>Technik, die dem<br />Geschäft <em>dient.</em></h2>
          <div class="service-grid">
            <div class="service-list" role="tablist" aria-label="Leistungswege">
              {services.map(({ name }, index) => (
                <button id={`service-tab-${index}`} role="tab" data-service aria-controls={`service-panel-${index}`} aria-selected={index === 0 ? 'true' : 'false'} tabindex={index === 0 ? '0' : '-1'}>
                  <span>0{index + 1}</span>{name}<b>↗</b>
                </button>
              ))}
            </div>
            <aside>{services.map(({ name, problem, result, scope, entry }, index) => <section id={`service-panel-${index}`} role="tabpanel" aria-labelledby={`service-tab-${index}`} data-service-panel><h3>{name}</h3><dl class="service-details"><div><dt>Ausgangslage</dt><dd>{problem}</dd></div><div><dt>Ergebnis</dt><dd>{result}</dd></div><div><dt>Leistungsrahmen</dt><dd>{scope}</dd></div><div><dt>Sinnvoller Einstieg</dt><dd>{entry}</dd></div></dl></section>)}<div class="code-card"><small>SYSTEMMODELL</small><strong>KLAR</strong><span>prüfbar · wartbar · übergabefähig</span></div></aside>
          </div>
          <a class="section-cta" href="#contact">Passenden Einstieg klären ↗</a>
        </div>
      </section>

      <section id="shopware" class="statement" data-reveal><p>Shopware ist unser technischer Fokus.</p><h2>Dein Geschäftsziel<br />bleibt der <em>Maßstab.</em></h2></section>
      <section id="approach" class="section approach" data-reveal>
        <div class="section-label">02 / Arbeitsweise</div>
        <div>
          <p class="eyebrow">Klarer Prozess</p><h2>Klare Entscheidungen.<br /><em>Saubere Umsetzung.</em></h2>
          <div class="steps">
            <article><span>01</span><h3>Verstehen</h3><p>Wir lesen System, Daten und Ziele, bevor wir Lösungen versprechen.</p></article>
            <article><span>02</span><h3>Entscheiden</h3><p>Wir machen Optionen, Risiken und Konsequenzen transparent.</p></article>
            <article><span>03</span><h3>Liefern</h3><p>Kleine, prüfbare Schritte. Dokumentiert, messbar und übergabefähig.</p></article>
            <article><span>04</span><h3>Verbessern</h3><p>Wir prüfen Wirkung und Betrieb und entwickeln das System gezielt weiter.</p></article>
          </div>
        </div>
      </section>
      <section class="section proof" data-reveal><div class="section-label">03 / Nachweis</div><div><p class="eyebrow">Was unsere Arbeit belastbar macht</p><h2>Ergebnisse brauchen<br /><em>Belege.</em></h2><div class="proof-grid"><article><span class="slot-status">Inhalt in Freigabe</span><h3>Shopware-Case</h3><p>Strukturierter Platz für Ausgangslage, Entscheidung, Umsetzung und freigegebenes Ergebnis.</p></article><article><span class="slot-status">Inhalt in Freigabe</span><h3>Arbeitsartefakt</h3><p>Platz für ein echtes, bereinigtes Architektur-, Analyse- oder Entscheidungsartefakt.</p></article><article><span class="slot-status">Inhalt in Freigabe</span><h3>Ergebnisbeleg</h3><p>Platz für einen verifizierten Beleg – ohne Dummy-Zahlen oder Wirkungsbehauptungen.</p><details><summary>Alternative: zweites Arbeitsartefakt</summary><p>Wird verwendet, falls kein belastbarer Ergebnisbeleg freigegeben werden kann.</p></details></article></div></div></section>
      <section class="section responsibility" data-reveal><div class="section-label">04 / Verantwortung</div><div><p class="eyebrow">Direkte Zusammenarbeit</p><h2>Klare Zuständigkeiten.<br /><em>Kurze Wege.</em></h2><p class="lead">Du arbeitest direkt mit den Menschen, die Entscheidungen vorbereiten und Lösungen umsetzen. Namen, Profile und Bildmaterial folgen erst nach Bestätigung.</p><div class="team-grid"><article><div class="role-visual" aria-hidden="true"></div><span>Rolle in Bestätigung</span><h3>Technische Strategie & Beratung</h3></article><article><div class="role-visual" aria-hidden="true"></div><span>Rolle in Bestätigung</span><h3>Shopware Engineering & Integration</h3></article><article><div class="role-visual" aria-hidden="true"></div><span>Rolle in Bestätigung</span><h3>Betrieb & Weiterentwicklung</h3></article></div></div></section>
      <section class="section faq" data-reveal><div class="section-label">05 / FAQ</div><div><p class="eyebrow">Kurze Antworten</p><h2>Was vor dem Start<br /><em>klar sein sollte.</em></h2><details><summary>Arbeitet ihr nur mit Shopware?</summary><p>Shopware ist unser technischer Fokus. Beratung, Integrationen, KI und individuelle Entwicklung ergänzen ihn dort, wo dein Geschäftsziel es erfordert.</p></details><details><summary>Übernehmt ihr bestehende Systeme?</summary><p>Ja – nach einer belastbaren Bestandsaufnahme. Wir verändern nichts, bevor Risiken, Rückfallweg und Zielbild klar sind.</p></details><details><summary>Wie beginnt ein Projekt?</summary><p>Mit einem fokussierten Gespräch zu Ausgangslage, Ziel und größtem Risiko. Danach schlagen wir einen klar abgegrenzten ersten Schritt vor.</p></details><details><summary>Wie funktionieren Übergabe und Betrieb?</summary><p>Entscheidungen und Änderungen werden nachvollziehbar dokumentiert. Das konkrete Betriebsmodell klären wir passend zu deinem System und deinem Team.</p></details><details><summary>Wann ist KI der richtige Ansatz?</summary><p>Wenn ein konkreter Prozess, geeignete Daten und ein überprüfbares Ziel zusammenkommen. Wenn eine einfachere Lösung sinnvoller ist, sagen wir das ebenfalls.</p></details><a class="section-cta" href="#contact">Projekt besprechen ↗</a></div></section>

      <section class="statement" data-reveal><p>Komplexität verschwindet nicht.</p><h2>Aber sie lässt sich<br /><em>beherrschen.</em></h2></section>

      <section id="contact" class="contact" data-reveal>
        <p class="eyebrow">Der nächste sinnvolle Schritt</p><h2>Lass uns dein Vorhaben<br />zuerst sauber <em>einordnen.</em></h2><p class="contact-intro">In einem ersten Gespräch klären wir Ausgangslage, Ziel und den sinnvollsten nächsten Schritt. Du erhältst eine ehrliche Einschätzung – auch dann, wenn noch kein Entwicklungsprojekt nötig ist.</p><div class="contact-facts"><span>30 Minuten</span><span>Kostenfrei & unverbindlich</span><span>Videocall · Telefon auf Wunsch</span></div><ol class="contact-steps"><li>Du beschreibst kurz dein Vorhaben oder das aktuelle Problem.</li><li>Wir prüfen, wer fachlich für das Gespräch sinnvoll ist.</li><li>Wir klären Ziel, Risiken und einen möglichen ersten Schritt.</li><li>Du erhältst eine klare Einordnung statt eines vorschnellen Angebots.</li></ol>
        <a href="mailto:info@digital-forces.de?subject=Shopware-Projekt%20besprechen">Projekt besprechen <span>↗</span></a><p class="contact-help">Schick uns vorab drei kurze Angaben: Was soll sich verbessern? Was blockiert aktuell? Gibt es einen relevanten Zeitrahmen?</p>
        <footer><span>DigitalForces · digital-forces.de</span><span>Impressum / Datenschutz · Review-Status</span><a href="mailto:info@digital-forces.de">info@digital-forces.de</a></footer>
      </section>
    </main>
  </div>
</Base>
