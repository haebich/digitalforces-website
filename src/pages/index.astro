---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
const services = [
  ['Commerce-Entwicklung', 'Wir entwickeln belastbare Commerce-Lösungen nah am Standard – von individuellen Erweiterungen bis zu komplexen Integrationen.'],
  ['Performance & Betrieb', 'Wir verbinden Code, Infrastruktur und Observability zu einem System, das auch unter Last ruhig bleibt.'],
  ['Technische Strategie', 'Wir übersetzen Geschäftsziele in klare Architekturentscheidungen, Roadmaps und überprüfbare Schritte.'],
  ['Wiederherstellung & Stabilität', 'Wir finden Ursachen, sichern den Betrieb und bauen Wiederholungsfehler systematisch aus dem Weg.'],
];
---
<Base title="DigitalForces — Commerce Engineering" description="Technische Exzellenz für anspruchsvolle E-Commerce-Systeme.">
  <div id="top" class="page-shell">
    <Header />
    <main>
      <section class="hero">
        <div class="hero-kicker"><span></span> Commerce Engineering · Deutschland</div>
        <div class="hero-variants" aria-label="Textvariante für Review"><button data-hero="problem" aria-pressed="true">Problemorientiert</button><button data-hero="result" aria-pressed="false">Ergebnisorientiert</button></div>
        <h1 data-hero-copy data-problem="Komplexe Shops.<br><em>Klare Systeme.</em>" data-result="E-Commerce,<br><em>der belastbar</em><br>funktioniert.">Komplexe Shops.<br /><em>Klare Systeme.</em></h1>
        <div class="hero-bottom">
          <p>Strategie, Commerce-Entwicklung und Infrastruktur aus einer Hand. Für Systeme, die nicht nur heute funktionieren.</p>
          <a class="circle-link" href="#expertise" aria-label="Expertise entdecken">↓</a>
        </div>
        <div class="orbit orbit-one"></div><div class="orbit orbit-two"></div>
      </section>

      <section class="signal" aria-label="Leistungsversprechen">
        <span>BAUEN</span><i>✦</i><span>BETREIBEN</span><i>✦</i><span>VERBESSERN</span><i>✦</i>
      </section>
      <section class="section problem" data-reveal><div class="section-label">00 / Ausgangslage</div><div><p class="eyebrow">Wenn Wachstum Reibung erzeugt</p><h2>Viele Symptome.<br />Ein <em>System.</em></h2><div class="flow"><span>Langsame Releases</span><b>→</b><span>Unklare Ursachen</span><b>→</b><span>Teure Risiken</span><strong>Analyse → Architektur → Betrieb</strong></div></div></section>

      <section id="expertise" class="section expertise" data-reveal>
        <div class="section-label">01 / Expertise</div>
        <div>
          <p class="eyebrow">Was wir lösen</p>
          <h2>Technik, die dem<br />Geschäft <em>dient.</em></h2>
          <div class="service-grid">
            <div class="service-list" role="tablist" aria-label="Leistungen">
              {services.map(([name, copy], index) => (
                <button data-service data-copy={copy} aria-selected={index === 0 ? 'true' : 'false'}>
                  <span>0{index + 1}</span>{name}<b>↗</b>
                </button>
              ))}
            </div>
            <aside><p data-service-copy>{services[0][1]}</p><div class="code-card"><small>SYSTEMMODELL</small><strong>KLAR</strong><span>prüfbar · wartbar · übergabefähig</span></div></aside>
          </div>
        </div>
      </section>

      <section id="approach" class="section approach" data-reveal>
        <div class="section-label">02 / Arbeitsweise</div>
        <div>
          <p class="eyebrow">Klarer Prozess</p><h2>Kein Theater.<br /><em>Saubere Arbeit.</em></h2>
          <div class="steps">
            <article><span>01</span><h3>Verstehen</h3><p>Wir lesen System, Daten und Ziele, bevor wir Lösungen versprechen.</p></article>
            <article><span>02</span><h3>Entscheiden</h3><p>Wir machen Optionen, Risiken und Konsequenzen transparent.</p></article>
            <article><span>03</span><h3>Liefern</h3><p>Kleine, prüfbare Schritte. Dokumentiert, messbar und übergabefähig.</p></article>
            <article><span>04</span><h3>Verbessern</h3><p>Wir prüfen Wirkung und Betrieb und entwickeln das System gezielt weiter.</p></article>
          </div>
        </div>
      </section>
      <section class="section proof" data-reveal><div class="section-label">03 / Nachweis</div><div><p class="eyebrow">Nachweise – Platzhalter für die Abstimmung</p><h2>Ergebnisse brauchen<br /><em>Belege.</em></h2><div class="proof-grid"><article><strong>—</strong><p>Messbarer Leistungsgewinn nach Freigabe</p></article><article><strong>—</strong><p>Freigegebene Projektreferenz</p></article><article><strong>—</strong><p>Verifizierte Betriebskennzahl</p></article></div></div></section>
      <section class="section responsibility" data-reveal><div class="section-label">04 / Verantwortung</div><div><p class="eyebrow">Direkte Zusammenarbeit</p><h2>Die Menschen am Tisch<br />lösen das <em>Problem.</em></h2><p class="lead">Strategie, Entwicklung und Betrieb arbeiten als ein System. Zuständigkeiten sind sichtbar, Entscheidungen dokumentiert und Übergaben kein Ratespiel.</p></div></section>
      <section class="section faq" data-reveal><div class="section-label">05 / FAQ</div><div><p class="eyebrow">Kurze Antworten</p><h2>Was vor dem Start<br /><em>klar sein sollte.</em></h2><details><summary>Arbeitet ihr nur mit Shopware?</summary><p>Shopware ist unser Schwerpunkt. Infrastruktur, Integrationen und technische Strategie betrachten wir systemübergreifend.</p></details><details><summary>Übernehmt ihr bestehende Systeme?</summary><p>Ja – nach einer belastbaren Bestandsaufnahme. Wir verändern nichts, bevor Risiken, Rückfallweg und Zielbild klar sind.</p></details><details><summary>Wie beginnt ein Projekt?</summary><p>Mit einem fokussierten technischen Gespräch und einem klar abgegrenzten ersten Prüfschritt.</p></details></div></section>

      <section class="statement" data-reveal><p>Komplexität verschwindet nicht.</p><h2>Aber sie lässt sich<br /><em>beherrschen.</em></h2></section>

      <section id="contact" class="contact" data-reveal>
        <p class="eyebrow">Bereit für den nächsten Schritt?</p><h2>Lasst uns Klarheit<br />ins System bringen.</h2>
        <span class="contact-placeholder">Kontaktweg wird nach Freigabe ergänzt <span>↗</span></span>
        <footer><span>DigitalForces · Entwurf 2026</span><span>Rechtliche Inhalte werden geprüft</span><span>Für belastbare Systeme.</span></footer>
      </section>
    </main>
  </div>
</Base>
