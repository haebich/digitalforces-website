---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import ContactCta from '../../components/ContactCta.astro';
import { withBase } from '../../config/site';
import { serviceClusters } from '../../data/service-clusters';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
---
<Base
  pathname="/leistungen/"
  title="Leistungen für Shopware und E-Commerce | DigitalForces"
  description="Shopware Engineering, E-Commerce-Beratung, System-Checks, Migrationen, Integrationen und technische Weiterentwicklung für komplexe E-Commerce-Systeme."
>
  <div class="route-shell">
    <Header currentPath={Astro.url.pathname} />
    <main id="main-content">
      <header class="route-hero">
        <p class="eyebrow">Leistungen</p>
        <h1>Leistungen, die dein System weiterbringen.</h1>
        <p>Nicht jede Herausforderung braucht sofort mehr Entwicklung. Wir schaffen zuerst Klarheit über System, Prozess und Priorität – und setzen danach den passenden Schritt um.</p>
      </header>

      <section class="route-intro" aria-labelledby="services-intro">
        <p class="section-label">01 / Leistungswege</p>
        <div>
          <p class="eyebrow">Passender Lösungsschnitt</p>
          <h2 id="services-intro">Der passende Einstieg.<br /><em>Ein klares Zielbild.</em></h2>
          <p class="lead">Wir beginnen nicht mit einem beliebigen Leistungspaket, sondern mit der Frage, was dein System und dein Geschäft als Nächstes wirklich brauchen.</p>
        </div>
      </section>

      <div class="service-catalog" aria-label="Leistungsübersicht">
        {serviceClusters.map((cluster) => {
          const entries = services.filter(({ data }) => data.cluster === cluster.id);
          return <section class="service-catalog-cluster" aria-labelledby={`catalog-cluster-${cluster.id}`}>
            <header><span>0{cluster.order}</span><h2 id={`catalog-cluster-${cluster.id}`}>{cluster.title}</h2></header>
            {entries.map(({ data }, index) => (
              <article id={data.slug}>
                <span class="catalog-index">{String(index + 1).padStart(2, '0')}</span>
                <div class="catalog-main">
                  <h3>{data.title}</h3>
                  <p class="catalog-description">{data.text}</p>
                  <dl>
                    <div><dt>Leistungsrahmen</dt><dd>{data.scopeText}</dd></div>
                    <div><dt>Sinnvoller Einstieg</dt><dd>{data.entry}</dd></div>
                  </dl>
                  <a class="catalog-link" href={withBase(data.href)}>{data.linkLabel} <span aria-hidden="true">→</span></a>
                </div>
              </article>
            ))}
          </section>;
        })}
      </div>

      <section class="route-process" aria-labelledby="process-title">
        <p class="section-label">02 / Arbeitsweise</p>
        <div>
          <p class="eyebrow">Klare Entscheidungen</p>
          <h2 id="process-title">Verstehen. Entscheiden. Liefern. Verbessern.</h2>
          <ol>
            <li><span>01</span><strong>System, Daten, Ziele und Abhängigkeiten klären.</strong></li>
            <li><span>02</span><strong>Optionen, Risiken und Konsequenzen transparent machen.</strong></li>
            <li><span>03</span><strong>In kleinen, prüfbaren und dokumentierten Schritten liefern.</strong></li>
            <li><span>04</span><strong>Wirkung und Betrieb prüfen und gezielt weiterentwickeln.</strong></li>
          </ol>
        </div>
      </section>

      <ContactCta
        title="Welcher Einstieg passt zu deinem System?"
        text="Im Erstgespräch ordnen wir Ausgangslage, Ziel und Abhängigkeiten ein und grenzen einen sinnvollen ersten Schritt ab."
        subject="Passenden Einstieg klären"
      />
    </main>
    <SiteFooter />
  </div>
</Base>
