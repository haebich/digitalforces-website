---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import ContactCta from '../../components/ContactCta.astro';

const cases = (await getCollection('cases', ({ data }) => data.publicationStatus === 'approved-internal')).sort((a, b) => a.data.order - b.data.order);
---
<Base
  pathname="/referenzen/"
  title="E-Commerce-Projekte und Referenzen | DigitalForces"
  description="Ausgewählte DigitalForces-Projekte mit nachvollziehbarem Leistungsrahmen – ohne unbelegte Wirkungsversprechen."
>
  <div class="route-shell">
    <Header currentPath={Astro.url.pathname} />
    <main id="main-content">
      <header class="route-hero route-hero-references">
        <p class="eyebrow">Projekte und Referenzen</p>
        <h1>Shopware und E-Commerce im praktischen Einsatz.</h1>
        <p>Wir zeigen Projektarbeit mit nachvollziehbarem Leistungsrahmen. Keine Logo-Sammlung, keine erfundenen Zahlen und keine Wirkung ohne Beleg.</p>
      </header>

      <section class="route-intro" aria-labelledby="references-intro">
        <p class="section-label">01 / Referenzen</p>
        <div>
          <p class="eyebrow">Belegbare Projektarbeit</p>
          <h2 id="references-intro">Weniger Behauptung.<br /><em>Mehr Kontext.</em></h2>
          <p class="lead">Jede veröffentlichte Referenz braucht bestätigte Fakten, einen klaren DigitalForces-Anteil und separat freigegebene Assets.</p>
        </div>
      </section>

      <section class="case-list" aria-label="Freigegebene Referenzen">
        {cases.map(({ data }, index) => (
          <article>
            <div class="case-visual" aria-label="Neutraler visueller Platzhalter">
              <span>0{index + 1}</span>
              <small>Bildmaterial nicht freigegeben</small>
            </div>
            <div class="case-copy">
              <p class="eyebrow">{data.eyebrow}</p>
              <h2>{data.title}</h2>
              <p>{data.summary}</p>
              <ul aria-label={`Leistungen für ${data.client}`}>{data.services.map((service) => <li>{service}</li>)}</ul>
            </div>
          </article>
        ))}
      </section>

      <ContactCta
        title="Ähnliches Vorhaben besprechen?"
        text="Wir klären, was an deiner Ausgangslage vergleichbar ist und wo ein anderer Lösungsschnitt sinnvoller wäre."
        subject="E-Commerce-Vorhaben besprechen"
      />
    </main>
    <SiteFooter />
  </div>
</Base>
