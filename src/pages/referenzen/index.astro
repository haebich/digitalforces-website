---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import ContactCta from '../../components/ContactCta.astro';

const cases = (await getCollection('cases', ({ data }) => data.publicationStatus === 'approved-internal')).sort((a, b) => a.data.order - b.data.order);
---
<Base
  pathname="/referenzen/"
  title="Referenzen und E-Commerce-Projekte | DigitalForces"
  description="Ausgewählte Shopware- und E-Commerce-Projekte von DigitalForces – mit nachvollziehbarem Leistungsrahmen statt unbelegter Wirkungsversprechen."
>
  <div class="route-shell">
    <Header currentPath={Astro.url.pathname} />
    <main id="main-content">
      <header class="route-hero route-hero-references">
        <p class="eyebrow">Projekte und Referenzen</p>
        <h1>Ausgewählte Projekte. Klarer Leistungsrahmen.</h1>
        <p>Wir zeigen Projektarbeit dann, wenn unser Beitrag nachvollziehbar beschrieben werden kann. Keine geschätzten Wirkungszahlen und keine Logo-Sammlung ohne Kontext.</p>
      </header>

      <section class="case-list" aria-label="Freigegebene Referenzen">
        {cases.map(({ data }, index) => (
          <article>
            <div class="case-visual" aria-hidden="true">
              <span>0{index + 1}</span>
            </div>
            <div class="case-copy">
              <p class="eyebrow">{data.eyebrow}</p>
              <h2>{data.title}</h2>
              <p>{data.summary}</p>
              <ul aria-label={`Leistungen für ${data.client}`}>{data.services.map((service) => <li>{service}</li>)}</ul>
            </div>
          </article>
        ))}
      </section>

      <ContactCta
        title="Ähnliches Vorhaben besprechen?"
        text="Wir klären, was an deiner Ausgangslage vergleichbar ist und wo ein anderer Lösungsschnitt sinnvoller wäre."
        subject="E-Commerce-Vorhaben besprechen"
      />
    </main>
    <SiteFooter />
  </div>
</Base>
