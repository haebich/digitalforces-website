---
import { contactHref, routes, withBase } from '../config/site';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const normalizedPath = currentPath.replace(base, '') || '/';
const links = [
  { href: withBase(routes.services), label: 'Leistungen', path: routes.services },
  { href: withBase(routes.references), label: 'Referenzen', path: routes.references },
  { href: `${withBase(routes.home)}#approach`, label: 'Arbeitsweise', path: '/#approach' },
  { href: contactHref(), label: 'Kontakt', path: 'mailto:' },
];
---
<header class="site-header">
  <a class="wordmark" href={withBase(routes.home)} aria-label="DigitalForces Startseite"><span>Digital</span><b>Forces</b></a>
  <nav aria-label="Hauptnavigation">
    {links.map((link) => <a href={link.href} aria-current={normalizedPath === link.path ? 'page' : undefined}>{link.label}</a>)}
  </nav>
  <a class="header-cta" href={contactHref()}>Erstgespräch vereinbaren <span aria-hidden="true">↗</span></a>
  <details class="mobile-nav">
    <summary>Menü</summary>
    <nav aria-label="Mobile Navigation">
      {links.map((link) => <a href={link.href} aria-current={normalizedPath === link.path ? 'page' : undefined}>{link.label}</a>)}
      <a href={contactHref()}>Erstgespräch vereinbaren</a>
    </nav>
  </details>
</header>
