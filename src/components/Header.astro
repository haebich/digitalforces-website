---
import { routes, withBase } from '../config/site';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const normalizedPath = currentPath.replace(base, '') || '/';
const links = [
  { href: withBase(routes.services), label: 'Leistungen', path: routes.services },
  { href: withBase(routes.references), label: 'Referenzen', path: routes.references },
  { href: `${withBase(routes.home)}#arbeitsweise`, label: 'Arbeitsweise', path: '/#arbeitsweise' },
  { href: `${withBase(routes.home)}#kontakt`, label: 'Kontakt', path: '/#kontakt' },
];
const isCurrent = (path: string) => path === routes.services
  ? normalizedPath.startsWith(routes.services)
  : normalizedPath === path;
---
<header class="site-header">
  <a class="wordmark" href={withBase(routes.home)} aria-label="DigitalForces Startseite"><span>Digital</span><b>Forces</b></a>
  <nav aria-label="Hauptnavigation">
    {links.map((link) => <a href={link.href} aria-current={isCurrent(link.path) ? 'page' : undefined}>{link.label}</a>)}
  </nav>
  <a class="header-cta" href={`${withBase(routes.home)}#kontakt`}>Erstgespräch vereinbaren <span aria-hidden="true">↗</span></a>
  <details class="mobile-nav">
    <summary>Menü</summary>
    <nav aria-label="Mobile Navigation">
      {links.map((link) => <a href={link.href} aria-current={isCurrent(link.path) ? 'page' : undefined}>{link.label}</a>)}
      <a href={`${withBase(routes.home)}#kontakt`}>Erstgespräch vereinbaren</a>
    </nav>
  </details>
</header>
